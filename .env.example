# Front-end (Vite) — these are embedded in the client bundle.
# Back4App App Settings -> Security & Keys
VITE_PARSE_APP_ID=your_back4app_application_id
VITE_PARSE_JS_KEY=your_back4app_javascript_key
VITE_PARSE_SERVER_URL=https://parseapi.back4app.com

# Serverless function only — never exposed to the browser.
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
