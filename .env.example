# Firebase web app config — Firebase Console → Project settings → "Your apps" → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional — defaults to <project-id>.firebaseapp.com
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Server-side only — used by the Netlify function (never shipped to the browser).
# Any OpenAI-compatible chat endpoint works (OpenAI, Groq, Gemini, OpenRouter...).
OPENAI_API_KEY=sk-your_openai_key
# Optional overrides (defaults: api.openai.com/v1, gpt-4o-mini)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=qwen/qwen3.8-27b
# Whisper model for the no-captions audio fallback
# (defaults: whisper-large-v3-turbo on Groq; use "whisper-1" on OpenAI)
# WHISPER_MODEL=whisper-large-v3-turbo
# Optional — Supadata transcript API (https://supadata.ai, free tier). When set,
# it is tried between direct captions and Whisper; strongly recommended on
# Netlify because YouTube blocks caption fetches from AWS IPs.
# SUPADATA_API_KEY=sd_your_supadata_key
